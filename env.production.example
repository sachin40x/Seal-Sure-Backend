# Production Environment Variables
NODE_ENV=production
PORT=10000

# Database Configuration (will be set by Render)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/sealsure

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=uploads
OUTPUT_PATH=outputs

# Python Service Configuration
PYTHON_SERVICE_URL=https://your-python-api-url.onrender.com

# Frontend URL
FRONTEND_URL=https://your-netlify-app.netlify.app

# Security Configuration
BCRYPT_ROUNDS=10
TOKEN_EXPIRY=1h

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Analytics Configuration
ANALYTICS_UPDATE_INTERVAL=3600000

# Admin Configuration
ADMIN_EMAIL=admin@sealsure.com
ADMIN_PASSWORD=admin123

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
